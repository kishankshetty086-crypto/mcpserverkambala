# Kambala Solutions WCAPI / Noren Client Configuration
WCAPI_BASE_URL=https://rama.kambala.co.in
OAUTH_AUTH_URL=https://rama.kambala.co.in/NorenWeb2.0/authorize/oauth

# Client Credentials (Replace with your broker / vendor credentials)
CLIENT_ID=YOUR_CLIENT_ID
SECRET_KEY=YOUR_SECRET_KEY

# Redirect URI for OAuth Callback
REDIRECT_URI=http://localhost:3000/oauth/callback
PORT=3000

# Session file location
SESSION_FILE=.session.json
